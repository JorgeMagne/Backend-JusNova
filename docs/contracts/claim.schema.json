{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/claim.schema.json",
  "title": "Claim",
  "description": "Afirmacion verificable generada por JusNova. Los claims criticos requieren citas validas por Citation Policy y Abstention Policy.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft",
      "Subfase 0.14 - Critical claim hardening",
      "Subfase 0.14 - Claim/Citation relation hardening",
      "Subfase 0.14 - Published claim support hardening"
    ]
  },
  "required": [
    "claim_id",
    "organization_id",
    "text",
    "claim_type",
    "criticality",
    "support_level",
    "citations",
    "verification_status",
    "requires_human_review"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^cl_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^org_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "claim_type": {
      "enum": [
        "plazo",
        "requisito",
        "competencia",
        "causal",
        "procedimiento",
        "norma",
        "jurisprudencia",
        "vigencia",
        "hecho_usuario",
        "hecho_documento",
        "inferencia",
        "recomendacion",
        "otro"
      ]
    },
    "criticality": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "support_level": {
      "enum": [
        "direct",
        "inferential",
        "weak",
        "unsupported"
      ]
    },
    "citations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "(?:^C[0-9]+$)(?![\\s\\S])",
        "maxLength": 160
      },
      "maxItems": 500
    },
    "verification_status": {
      "enum": [
        "passed",
        "failed",
        "needs_review",
        "blocked"
      ]
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "enum": [
              "plazo",
              "requisito",
              "competencia",
              "causal",
              "procedimiento",
              "norma",
              "jurisprudencia",
              "vigencia"
            ]
          }
        },
        "required": [
          "claim_type"
        ]
      },
      "then": {
        "properties": {
          "criticality": {
            "const": "high"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criticality": {
            "const": "high"
          },
          "verification_status": {
            "const": "passed"
          }
        },
        "required": [
          "criticality",
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "passed"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "support_level": {
            "enum": [
              "direct",
              "inferential"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "support_level": {
            "const": "unsupported"
          }
        },
        "required": [
          "support_level"
        ]
      },
      "then": {
        "properties": {
          "verification_status": {
            "enum": [
              "failed",
              "needs_review",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "needs_review"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "requires_human_review": {
            "const": true
          }
        }
      }
    }
  ],
  "examples": [
    {
      "claim_id": "cl_001",
      "organization_id": "org_001",
      "text": "El recurso de casacion exige cumplir los requisitos formales aplicables.",
      "claim_type": "procedimiento",
      "criticality": "high",
      "support_level": "direct",
      "citations": [
        "C1"
      ],
      "verification_status": "passed",
      "requires_human_review": false
    }
  ],
  "x-invalid-examples": [
    {
      "claim_id": "cl_002",
      "organization_id": "org_001",
      "text": "La norma esta vigente.",
      "claim_type": "vigencia",
      "criticality": "high",
      "support_level": "unsupported",
      "citations": [],
      "verification_status": "passed",
      "requires_human_review": false
    },
    {
      "claim_id": "cl_005",
      "organization_id": "org_001",
      "text": "La norma esta vigente.",
      "claim_type": "vigencia",
      "criticality": "high",
      "support_level": "unsupported",
      "citations": [
        "C1"
      ],
      "verification_status": "passed",
      "requires_human_review": false
    },
    {
      "claim_id": "cl_006",
      "organization_id": "org_001",
      "text": "La conclusion requiere revision humana.",
      "claim_type": "otro",
      "criticality": "medium",
      "support_level": "weak",
      "citations": [
        "C1"
      ],
      "verification_status": "needs_review",
      "requires_human_review": false
    },
    {
      "claim_id": "cl_missing_org",
      "text": "Claim sin tenant explicito.",
      "claim_type": "otro",
      "criticality": "low",
      "support_level": "weak",
      "citations": [],
      "verification_status": "needs_review",
      "requires_human_review": true
    },
    {
      "claim_id": "cl_norma_low_without_citation",
      "organization_id": "org_001",
      "text": "La norma establece una obligacion aplicable.",
      "claim_type": "norma",
      "criticality": "low",
      "support_level": "weak",
      "citations": [],
      "verification_status": "passed",
      "requires_human_review": false
    },
    {
      "claim_id": "cl_duplicate_citation",
      "organization_id": "org_001",
      "text": "El mismo soporte no se duplica dentro de un claim.",
      "claim_type": "procedimiento",
      "criticality": "high",
      "support_level": "direct",
      "citations": [
        "C1",
        "C1"
      ],
      "verification_status": "passed",
      "requires_human_review": false
    },
    {
      "claim_id": "cl_passed_with_weak_support",
      "organization_id": "org_001",
      "text": "La conclusion tiene soporte debil y requiere revision.",
      "claim_type": "otro",
      "criticality": "medium",
      "support_level": "weak",
      "citations": [
        "C1"
      ],
      "verification_status": "passed",
      "requires_human_review": false
    }
  ],
  "x-policy-invalid-examples": [
    {
      "claim_id": "cl_004",
      "organization_id": "org_001",
      "text": "La norma aplicable establece el requisito critico.",
      "claim_type": "norma",
      "criticality": "high",
      "support_level": "direct",
      "citations": [
        "C99"
      ],
      "verification_status": "passed",
      "requires_human_review": false
    }
  ]
}
