{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/retrieval-run.schema.json",
  "title": "RetrievalRun",
  "description": "Ejecucion trazable de un RetrievalPlan. Registra proveedores, resultados, fuentes rechazadas, calidad, costos estimados y razones cerradas de no evidencia.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.5 - Live Legal Search Engine Contract",
    "amendments": [
      "Subfase 0.10 - Seguridad, privacidad y proveedores externos"
    ]
  },
  "required": [
    "retrieval_run_id",
    "organization_id",
    "query_id",
    "retrieval_plan_id",
    "status",
    "providers_used",
    "adapter_calls",
    "discovery_results",
    "sources_opened",
    "sources_rejected",
    "latency_ms",
    "estimated_cost",
    "warnings",
    "started_at",
    "completed_at",
    "prompt_injection_risks"
  ],
  "properties": {
    "retrieval_run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^rr_[A-Za-z0-9_-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed_with_evidence",
        "completed_no_evidence",
        "failed",
        "cancelled",
        "budget_exhausted"
      ]
    },
    "providers_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "adapter_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adapter_name",
          "status"
        ],
        "properties": {
          "adapter_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "partial",
              "error",
              "timeout",
              "skipped"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "success",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "error_code": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "partial",
                    "error",
                    "timeout"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "error_code"
              ],
              "properties": {
                "error_code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "discovery_results": {
      "type": "array",
      "items": {
        "$ref": "./legal-search-result.schema.json"
      }
    },
    "sources_opened": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "sources_rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "reason"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "enum": [
              "foreign_jurisdiction",
              "low_authority",
              "duplicate",
              "not_extractable",
              "access_not_allowed",
              "tier_not_allowed",
              "irrelevant"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "no_evidence_reason": {
      "enum": [
        "no_evidence_found",
        "insufficient_budget",
        "official_sources_down",
        "conflict_unresolved",
        "missing_user_info",
        "access_not_allowed",
        "extraction_failed"
      ]
    },
    "quality": {
      "$ref": "./evidence-quality.schema.json"
    },
    "error": {
      "type": "object",
      "required": [
        "error_code",
        "message"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cancellation_reason": {
      "enum": [
        "user_cancelled",
        "timeout_cancelled",
        "system_cancelled",
        "superseded_by_new_run"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_cost": {
      "type": "number",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_injection_risks": {
      "type": "array",
      "items": {
        "$ref": "./prompt-injection-risk.schema.json"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed_with_evidence"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "quality",
          "evidence_pack_id"
        ],
        "properties": {
          "quality": {
            "properties": {
              "overall": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "CONFLICTIVE"
                ]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "no_evidence_reason"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "cancellation_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed_no_evidence"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "quality",
          "no_evidence_reason"
        ],
        "properties": {
          "quality": {
            "properties": {
              "overall": {
                "enum": [
                  "NONE",
                  "LOW",
                  "CONFLICTIVE"
                ]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence_pack_id"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "cancellation_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence_pack_id"
              ]
            },
            {
              "required": [
                "no_evidence_reason"
              ]
            },
            {
              "required": [
                "quality"
              ]
            },
            {
              "required": [
                "cancellation_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "budget_exhausted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "no_evidence_reason"
        ],
        "properties": {
          "no_evidence_reason": {
            "const": "insufficient_budget"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence_pack_id"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "quality"
              ]
            },
            {
              "required": [
                "cancellation_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "cancellation_reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence_pack_id"
              ]
            },
            {
              "required": [
                "no_evidence_reason"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "quality"
              ]
            }
          ]
        }
      }
    }
  ],
