{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/tool-call.schema.json",
  "title": "ToolCall",
  "description": "Registro minimizado de una llamada a tool interna o proveedor. No almacena payloads crudos.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado",
    "amendments": [
      "Subfase 0.10 - Seguridad, privacidad y proveedores externos"
    ]
  },
  "required": [
    "tool_call_id",
    "organization_id",
    "tool_name",
    "purpose",
    "input_hash",
    "status",
    "started_at",
    "completed_at",
    "cost_units",
    "external_provider_call",
    "provider_call_audit_id"
  ],
  "properties": {
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "success",
        "error",
        "timeout",
        "rate_limited",
        "cancelled"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "tool_error",
        "tool_timeout",
        "rate_limited",
        "cancelled_by_user",
        "cancelled_by_budget",
        "cancelled_by_timeout",
        "cancelled_by_system",
        "policy_blocked",
        null
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_units": {
      "type": "object",
      "required": [
        "requests",
        "pages",
        "tokens",
        "estimated_cost"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "external_provider_call": {
      "type": "boolean"
    },
    "provider_call_audit_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pca_[A-Za-z0-9_-]+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "output_hash"
        ],
        "properties": {
          "output_hash": {
            "type": "string",
            "minLength": 1,
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "enum": [
              "tool_error",
              "policy_blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "timeout"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "const": "tool_timeout"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rate_limited"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "const": "rate_limited"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "enum": [
              "cancelled_by_user",
              "cancelled_by_budget",
              "cancelled_by_timeout",
              "cancelled_by_system"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "external_provider_call": {
            "const": true
          }
        },
        "required": [
          "external_provider_call"
        ]
      },
      "then": {
        "properties": {
          "provider_call_audit_id": {
            "type": "string",
            "pattern": "^pca_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "external_provider_call": {
            "const": false
          }
        },
        "required": [
          "external_provider_call"
        ]
      },
      "then": {
        "properties": {
          "provider_call_audit_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "tool_call_id": "tc_001",
      "tool_name": "LiveLegalSearchEngine",
      "purpose": "legal_search",
      "input_hash": "sha256:43dddbfba1d912b232d89ad1cf2891ae2d8a77efd4f23bbe85b229f09a8a7ab0",
