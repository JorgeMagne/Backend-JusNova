      "purpose": "retrieval_planning",
      "provider": "openai",
      "model": "gpt-5",
      "prompt_version": "retrieval-planning-v1",
      "input_hash": "sha256:input002",
      "output_hash": null,
      "token_usage": {
        "input_tokens": 500,
        "output_tokens": 0,
        "total_tokens": 500
      },
      "started_at": "2026-05-22T00:00:00Z",
      "completed_at": "2026-05-22T00:00:01Z",
      "status": "error",
      "error_code": "rate_limited"
    }
  ],
