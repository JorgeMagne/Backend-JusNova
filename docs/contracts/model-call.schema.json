{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/model-call.schema.json",
  "title": "ModelCall",
  "description": "Registro minimizado de una llamada a modelo. No almacena prompt crudo, salida cruda, documento completo ni mensaje completo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado",
    "amendments": [
      "Subfase 0.10 - Seguridad, privacidad y proveedores externos",
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
    ]
  },
  "required": [
    "model_call_id",
    "organization_id",
    "purpose",
    "provider",
    "model",
    "prompt_version",
    "input_hash",
    "token_usage",
    "started_at",
    "completed_at",
    "status",
    "external_provider_call",
    "provider_call_audit_id"
  ],
  "properties": {
    "model_call_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^mc_[A-Za-z0-9_-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^org_[A-Za-z0-9_-]+$"
    },
    "purpose": {
      "enum": [
        "intent_classification",
        "retrieval_planning",
        "fact_extraction",
        "answer_generation",
        "claim_extraction",
        "citation_repair",
        "verification",
        "memory_update",
        "other"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "token_usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "success",
        "error",
        "timeout",
        "cancelled"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "provider_error",
        "provider_timeout",
        "rate_limited",
        "cancelled_by_user",
        "cancelled_by_budget",
        "cancelled_by_timeout",
        "cancelled_by_system",
        "policy_blocked",
        null
      ]
    },
    "external_provider_call": {
      "type": "boolean"
    },
    "provider_call_audit_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pca_[A-Za-z0-9_-]+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "output_hash"
        ],
        "properties": {
          "output_hash": {
            "type": "string",
            "minLength": 1,
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "enum": [
              "provider_error",
              "rate_limited",
              "policy_blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "timeout"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "const": "provider_timeout"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "output_hash": {
            "type": "null"
          },
          "error_code": {
            "enum": [
              "cancelled_by_user",
              "cancelled_by_budget",
              "cancelled_by_timeout",
              "cancelled_by_system"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "external_provider_call": {
            "const": true
          }
        },
        "required": [
          "external_provider_call"
        ]
      },
      "then": {
        "properties": {
          "provider_call_audit_id": {
            "type": "string",
            "pattern": "^pca_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "external_provider_call": {
            "const": false
          }
        },
        "required": [
          "external_provider_call"
        ]
      },
      "then": {
        "properties": {
          "provider_call_audit_id": {
            "type": "null"
          }
        }
      }
    }
  ],
