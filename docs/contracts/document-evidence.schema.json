{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/document-evidence.schema.json",
  "title": "DocumentEvidence",
  "description": "Fragmento documental privado o de usuario convertido en evidencia citable por pagina/localizador. No representa norma vigente ni fuente oficial.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.9 - Conversacion, memoria, documentos y OCR"
  },
  "required": [
    "organization_id",
    "document_id",
    "document_version_id",
    "document_version_hash",
    "source_ref",
    "passage_ref",
    "page",
    "text",
    "text_hash",
    "locator",
    "extraction_method",
    "extraction_confidence",
    "warnings",
    "citation_eligible",
    "created_at"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "document_version_id": {
      "type": "string",
      "minLength": 1
    },
    "document_version_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^D[0-9]+$"
    },
    "passage_ref": {
      "type": "string",
      "pattern": "^D[0-9]+:P[0-9]+$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "text_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "locator": {
      "$ref": "#/$defs/locator"
    },
    "extraction_method": {
      "enum": [
        "native_text",
        "ocr",
        "model_vision"
      ]
    },
    "vision_escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low_ocr_confidence",
        "signature_or_stamp",
        "table_or_layout",
        "handwriting",
        "critical_fragment",
        "poor_scan_quality",
        null
      ]
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "low_confidence",
          "ocr_noise",
          "layout_uncertain",
          "handwriting_detected",
          "stamp_or_signature",
          "manual_review_required"
        ]
      },
      "uniqueItems": true
    },
    "citation_eligible": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "page",
        "article",
        "section",
        "paragraph",
        "coordinates",
        "url_fragment"
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "article": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "coordinates": {
          "type": [
            "object",
            "null"
          ]
        },
        "url_fragment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "citation_eligible": {
            "const": true
          }
        },
        "required": [
          "citation_eligible"
        ]
      },
      "then": {
        "properties": {
          "extraction_confidence": {
            "minimum": 0.85
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction_confidence": {
            "exclusiveMaximum": 0.85
          }
        },
        "required": [
          "extraction_confidence"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "contains": {
              "enum": [
                "low_confidence",
                "manual_review_required"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction_method": {
            "const": "model_vision"
          }
        },
        "required": [
          "extraction_method"
        ]
      },
      "then": {
        "required": [
          "vision_escalation_reason"
        ],
        "properties": {
          "vision_escalation_reason": {
            "type": "string",
            "enum": [
              "low_ocr_confidence",
              "signature_or_stamp",
              "table_or_layout",
              "handwriting",
              "critical_fragment",
              "poor_scan_quality"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "vision_escalation_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
