{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/citation-audit.schema.json",
  "title": "CitationAudit",
  "description": "Resultado estructurado del auditor de citas. Registra estado de auditoria, resultados por cita y fallas bloqueantes sin almacenar evidencia cruda.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado"
  },
  "required": [
    "citation_audit_id",
    "auditor_version",
    "overall_status",
    "results",
    "blocking_failures",
    "warnings",
    "created_at"
  ],
  "properties": {
    "citation_audit_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_version": {
      "type": "string",
      "minLength": 1
    },
    "overall_status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "needs_review"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation_audit_result"
      }
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocking_failure"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "citation_audit_result": {
      "type": "object",
      "required": [
        "citation_ref",
        "claim_id",
        "passage_ref",
        "source_ref",
        "status",
        "support_assessment",
        "severity"
      ],
      "properties": {
        "citation_ref": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_ref": {
          "type": "string",
          "pattern": "^[FD][0-9]+:P[0-9]+$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^F[0-9]+$|^D[0-9]+$"
        },
        "status": {
          "enum": [
            "valid",
            "broken",
            "unsupported",
            "weak",
            "needs_review"
          ]
        },
        "support_assessment": {
          "enum": [
            "direct",
            "inferential",
            "weak",
            "unsupported",
            "not_found"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "blocking"
          ]
        }
      },
      "additionalProperties": false
    },
    "blocking_failure": {
      "type": "object",
      "description": "Falla bloqueante del auditor. Puede representar fallas de cita/fuente/pasaje o un bloqueo de politica no relacionado con una cita mediante failure_code = policy_blocked y referencias nulas.",
      "required": [
        "failure_code",
        "citation_ref",
        "claim_id",
        "severity"
      ],
      "properties": {
        "failure_code": {
          "enum": [
            "citation_missing",
            "passage_missing",
            "source_missing",
            "unsupported_claim",
            "tier3_only_critical_support",
            "validity_not_confirmed",
            "decorative_source",
            "source_passage_mismatch",
            "policy_blocked"
          ]
        },
        "citation_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C[0-9]+$"
        },
        "claim_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "blocking"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "failure_code": {
                "const": "policy_blocked"
              }
            },
            "required": [
              "failure_code"
            ]
          },
          "then": {
            "properties": {
              "citation_ref": {
                "const": null
              },
              "claim_id": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "failure_code": {
                "const": "citation_missing"
              }
            },
            "required": [
              "failure_code"
            ]
          },
          "then": {
            "properties": {
              "citation_ref": {
                "const": null
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "failure_code": {
                "enum": [
                  "passage_missing",
                  "source_missing",
                  "unsupported_claim",
                  "tier3_only_critical_support",
                  "validity_not_confirmed",
                  "decorative_source",
                  "source_passage_mismatch"
                ]
              }
            },
            "required": [
              "failure_code"
            ]
          },
          "then": {
            "properties": {
              "citation_ref": {
                "type": "string",
                "pattern": "^C[0-9]+$"
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "passed"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "valid"
                },
                "severity": {
                  "const": "low"
                },
                "support_assessment": {
                  "enum": [
                    "direct",
                    "inferential"
                  ]
                }
              }
            }
          },
          "blocking_failures": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "enum": [
              "failed",
              "blocked"
            ]
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "blocking_failures": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "needs_review"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "blocking_failures": {
            "maxItems": 0
          }
        },
        "anyOf": [
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "results": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "needs_review"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "results": {
                "contains": {
                  "properties": {
                    "severity": {
                      "enum": [
                        "medium",
                        "high"
                      ]
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "blocking"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "then": {
        "properties": {
          "overall_status": {
            "enum": [
              "failed",
              "blocked"
            ]
          },
          "blocking_failures": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "examples": [
    {
