{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/citation.schema.json",
  "title": "Citation",
  "description": "Cita auditada que conecta un claim con un pasaje y una fuente. La existencia cruzada passage/source se valida por Citation Policy y tests de auditoria.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft",
      "Subfase 0.14 - Claim/Citation relation hardening",
      "Subfase 0.14 - Sanitized auditor-note bounds"
    ]
  },
  "required": [
    "citation_ref",
    "organization_id",
    "passage_ref",
    "source_ref",
    "status",
    "supports_claim_ids",
    "auditor_notes"
  ],
  "properties": {
    "citation_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^C[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^org_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "passage_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^[FD][0-9]+:P[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^F[0-9]+$|^D[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "status": {
      "enum": [
        "valid",
        "broken",
        "unsupported",
        "weak",
        "needs_review"
      ]
    },
    "supports_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "(?:^cl_[A-Za-z0-9_-]+$)(?![\\s\\S])",
        "maxLength": 160
      },
      "maxItems": 500
    },
    "auditor_notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "(?:^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$)(?![\\s\\S])"
      },
      "maxItems": 32
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "passage_ref": {
            "pattern": "(?:^F[0-9]+:P[0-9]+$)(?![\\s\\S])"
          }
        },
        "required": [
          "passage_ref"
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "pattern": "(?:^F[0-9]+$)(?![\\s\\S])"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passage_ref": {
            "pattern": "(?:^D[0-9]+:P[0-9]+$)(?![\\s\\S])"
          }
        },
        "required": [
          "passage_ref"
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "pattern": "(?:^D[0-9]+$)(?![\\s\\S])"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "citation_ref": "C1",
      "organization_id": "org_001",
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [
        "cl_001"
      ],
      "auditor_notes": []
    }
  ],
  "x-invalid-examples": [
    {
      "citation_ref": "C1",
      "organization_id": "org_001",
      "passage_ref": "missing",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [
        "cl_001"
      ],
      "auditor_notes": []
    },
    {
      "citation_ref": "C9",
      "organization_id": "org_001",
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [],
      "auditor_notes": []
    },
    {
      "citation_ref": "C10",
      "organization_id": "org_001",
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "status": "weak",
      "supports_claim_ids": [],
      "auditor_notes": [
        "Toda cita contractual debe estar asociada al menos a un claim, aunque su auditoria no sea valid."
      ]
    },
    {
      "citation_ref": "C13",
      "organization_id": "org_001",
      "passage_ref": "F1:P1",
      "source_ref": "D1",
      "status": "weak",
      "supports_claim_ids": [
        "cl_001"
      ],
      "auditor_notes": [
        "Una cita F no puede apuntar a una fuente D."
      ]
    },
    {
      "citation_ref": "C11",
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [
        "cl_001"
      ],
      "auditor_notes": []
    },
    {
      "citation_ref": "C12",
      "organization_id": "org_001",
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [
        "cl_001",
        "cl_001"
      ],
      "auditor_notes": []
    }
  ],
  "x-policy-invalid-examples": [
    {
      "citation_ref": "C2",
      "organization_id": "org_001",
      "passage_ref": "F1:P999",
      "source_ref": "F1",
      "status": "valid",
      "supports_claim_ids": [
        "cl_001"
      ],
      "auditor_notes": [
        "Estructuralmente valida, pero el pasaje no existe en el EvidencePack."
      ]
    }
  ]
}
