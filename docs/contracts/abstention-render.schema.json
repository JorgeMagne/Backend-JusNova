{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/abstention-render.schema.json",
  "title": "AbstentionRender",
  "description": "Metadata versionada para reconstruir una abstencion total o bloqueo sin guardar respuesta completa, prompts, documentos completos, mensajes completos ni salidas completas del modelo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado",
    "amendments": [
      "Subfase 0.8 - Cost Governor, planes y presupuestos",
      "Subfase 0.9 - Conversacion, memoria, documentos y OCR fixture alignment",
      "Subfase 0.10 - Seguridad, privacidad y proveedores externos",
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
    ]
  },
  "required": [
    "abstention_render_id",
    "trace_id",
    "answer_id",
    "answer_version",
    "response_outcome",
    "render_hash",
    "render_storage_ref",
    "reason_code",
    "redaction_profile",
    "source_trace_refs",
    "created_at",
    "created_by_ref"
  ],
  "properties": {
    "abstention_render_id": {
      "type": "string",
      "pattern": "^abstention_render_[A-Za-z0-9_-]+$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "answer_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ans_[A-Za-z0-9_-]+$"
    },
    "answer_version": {
      "type": "integer",
      "minimum": 1
    },
    "response_outcome": {
      "enum": [
        "total_abstention",
        "blocked"
      ]
    },
    "render_hash": {
      "description": "Hash sha256 de la representacion canonica renderizada de la abstencion o bloqueo. No es texto renderizado.",
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "render_storage_ref": {
      "description": "Referencia interna e inmutable al objeto renderizado. No debe ser URL cruda ni contener contenido del usuario.",
      "type": "string",
      "pattern": "^(render|abstention_render|snap|obj)_[A-Za-z0-9_-]+$"
    },
    "rendered_answer_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^render_snap_[A-Za-z0-9_-]+$"
    },
    "reason_code": {
      "description": "Debe usar el mismo vocabulario que TraceObject.abstention_reason y coincidir con ese campo por validador cross-contract.",
      "enum": [
        "no_evidence",
        "unsupported_critical_claim",
        "conflict_unresolved",
        "missing_user_info",
        "insufficient_budget",
        "validity_not_confirmed",
        "policy_blocked"
      ]
    },
    "redaction_profile": {
      "enum": [
        "USER_SUMMARY_SAFE",
        "SUPPORT_VIEW_SAFE",
        "INTERNAL_AUDIT_REF_ONLY"
      ]
    },
    "source_trace_refs": {
      "description": "Referencias usadas para reconstruir la abstencion o bloqueo. Deben ser subconjuntos de TraceObject.evidence_pack_ids, TraceObject.claims[].claim_id, TraceObject.citation_audit.results/blocking_failures citation refs, TraceObject.sources_used[] y TraceObject.sources_rejected[].source_ref por validador cross-contract.",
      "type": "object",
      "required": [
        "evidence_pack_ids",
        "claim_ids",
        "citation_refs",
        "source_refs"
      ],
      "properties": {
        "evidence_pack_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^ep_[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^cl_[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "citation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^F[0-9]+$|^D[0-9]+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "warning_codes": {
      "type": "array",
      "items": {
        "enum": [
          "no_evidence_found",
          "insufficient_evidence",
          "validity_not_confirmed",
          "conflict_unresolved",
          "missing_case_data",
          "source_unavailable",
          "policy_blocked"
        ]
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(system|actor_hash_[A-Za-z0-9_-]+|support_hash_[A-Za-z0-9_-]+|service_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
    }
  },
  "additionalProperties": false,
