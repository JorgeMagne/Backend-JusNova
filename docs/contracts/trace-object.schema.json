{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/trace-object.schema.json",
  "title": "TraceObject",
  "description": "Traza minimizada y reconstruible de una respuesta legal. Registra referencias, hashes, resultados de auditoria, costos y latencias sin material crudo sensible.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado"
  },
  "required": [
    "trace_id",
    "organization_id",
    "actor_ref",
    "actor_type",
    "answer_id",
    "answer_version_ref",
    "answer_version",
    "conversation_id",
    "response_outcome",
    "created_at",
    "model_calls",
    "tool_calls",
    "retrieval_runs",
    "evidence_pack_ids",
    "sources_used",
    "sources_rejected",
    "claims",
    "citation_audit",
    "cost",
    "latency_ms",
    "warnings"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "support",
        "service"
      ]
    },
    "answer_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_version_ref": {
      "type": "string",
      "minLength": 1
    },
    "answer_version": {
      "type": "integer",
      "minimum": 1
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "response_outcome": {
      "enum": [
        "answered",
        "partial_abstention",
        "total_abstention",
        "blocked"
      ]
    },
    "abstention_reason": {
      "enum": [
        "no_evidence",
        "unsupported_critical_claim",
        "conflict_unresolved",
        "missing_user_info",
        "insufficient_budget",
        "validity_not_confirmed",
        "policy_blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_calls": {
      "type": "array",
      "items": {
        "$ref": "./model-call.schema.json"
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "./tool-call.schema.json"
      }
    },
    "retrieval_runs": {
      "type": "array",
      "items": {
        "$ref": "./retrieval-run.schema.json"
      }
    },
    "evidence_pack_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F[0-9]+$|^D[0-9]+$"
      },
      "uniqueItems": true
    },
    "sources_rejected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejected_source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./claim.schema.json"
      }
    },
    "citation_audit": {
      "$ref": "./citation-audit.schema.json"
    },
    "cost": {
      "$ref": "./cost-report.schema.json"
    },
    "latency_ms": {
      "$ref": "#/$defs/latency_report"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "rejected_source": {
      "type": "object",
      "required": [
        "source_ref",
        "result_id",
        "url_hash",
        "reason",
        "tier",
        "source_type",
        "rejected_at",
        "warning_codes"
      ],
      "properties": {
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^F[0-9]+$|^D[0-9]+$"
        },
        "result_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "url_hash": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "foreign_jurisdiction",
            "low_authority",
            "duplicate",
            "not_extractable",
            "access_not_allowed",
            "tier_not_allowed",
            "irrelevant",
            "unsupported_for_critical_claim"
          ]
        },
        "tier": {
          "enum": [
            "TIER1_CANONICO",
            "TIER1_OFICIAL",
            "TIER1_STRUCTURED",
            "TIER2_CONFIABLE",
            "TIER3_SECUNDARIO",
            "USER_DOCUMENT"
          ]
        },
        "source_type": {
          "enum": [
            "norma",
            "jurisprudencia",
            "documento_usuario",
            "doctrina",
            "web",
            "institucional"
          ]
        },
        "rejected_at": {
          "type": "string",
          "format": "date-time"
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "latency_report": {
      "type": "object",
      "required": [
        "total",
        "model_total",
        "tool_total",
        "retrieval_total",
        "citation_audit",
        "persistence",
        "queue"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "model_total": {
          "type": "integer",
          "minimum": 0
        },
        "tool_total": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_total": {
          "type": "integer",
          "minimum": 0
        },
        "citation_audit": {
          "type": "integer",
          "minimum": 0
        },
        "persistence": {
          "type": "integer",
          "minimum": 0
        },
        "queue": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "answered"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "abstention_reason"
          ]
        },
        "properties": {
          "model_calls": {
            "minItems": 1
          },
          "evidence_pack_ids": {
            "minItems": 1
          },
          "sources_used": {
            "minItems": 1
          },
          "claims": {
            "minItems": 1
          },
          "citation_audit": {
            "properties": {
              "overall_status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "partial_abstention"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "abstention_reason"
            ]
          },
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "model_calls": {
            "minItems": 1
          },
          "evidence_pack_ids": {
            "minItems": 1
          },
          "sources_used": {
            "minItems": 1
          },
          "claims": {
            "minItems": 1
          },
          "citation_audit": {
            "properties": {
              "overall_status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "total_abstention"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "abstention_reason"
            ]
          },
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "blocked"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "abstention_reason"
            ]
          },
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "total_abstention"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "properties": {
          "citation_audit": {
            "properties": {
              "overall_status": {
                "enum": [
                  "failed",
                  "blocked",
                  "needs_review"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "const": "blocked"
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "properties": {
          "citation_audit": {
            "properties": {
              "overall_status": {
                "enum": [
                  "failed",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    }
  ],
