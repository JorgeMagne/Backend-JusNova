{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/answer-version.schema.json",
  "title": "AnswerVersion",
  "description": "Version estable de una respuesta legal. No almacena respuesta completa ni material sensible; referencia AnswerContract para respuestas sustantivas o AbstentionRender para abstenciones/bloqueos y conserva hashes.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.7 - Trazabilidad, auditoria y versionado",
    "amended_by": "Subfase 0.8 - Cost Governor, planes y presupuestos"
  },
  "required": [
    "answer_version_id",
    "answer_id",
    "answer_version",
    "previous_answer_version",
    "response_outcome",
    "answer_hash",
    "trace_id",
    "answer_contract_ref",
    "version_reason",
    "created_at",
    "created_by_ref"
  ],
  "properties": {
    "answer_version_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_answer_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "response_outcome": {
      "enum": [
        "answered",
        "partial_abstention",
        "total_abstention",
        "blocked"
      ]
    },
    "answer_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_contract_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "abstention_render_ref": {
      "description": "Referencia a abstention-render.schema.json para total_abstention o blocked.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "rendered_answer_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "version_reason": {
      "enum": [
        "initial_answer",
        "citation_repaired",
        "answer_regenerated",
        "evidence_updated",
        "validity_revalidated",
        "feedback_correction",
        "formal_export",
        "source_added",
        "source_removed",
        "claim_corrected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(system|actor_hash_[A-Za-z0-9_-]+|support_hash_[A-Za-z0-9_-]+|service_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "answer_version": {
            "const": 1
          }
        },
        "required": [
          "answer_version"
        ]
      },
      "then": {
        "properties": {
          "previous_answer_version": {
            "type": "null"
          },
          "version_reason": {
            "const": "initial_answer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answer_version": {
            "minimum": 2
          }
        },
        "required": [
          "answer_version"
        ]
      },
      "then": {
        "properties": {
          "previous_answer_version": {
            "type": "integer",
            "minimum": 1
          },
          "version_reason": {
            "not": {
              "const": "initial_answer"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "enum": [
              "answered",
              "partial_abstention"
            ]
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "properties": {
          "answer_contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "abstention_render_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "response_outcome": {
            "enum": [
              "total_abstention",
              "blocked"
            ]
          }
        },
        "required": [
          "response_outcome"
        ]
      },
      "then": {
        "required": [
          "abstention_render_ref"
        ],
        "properties": {
          "answer_contract_ref": {
            "type": "null"
          },
          "abstention_render_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
