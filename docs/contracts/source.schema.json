{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/source.schema.json",
  "title": "EvidenceSource",
  "description": "Fuente normalizada usada dentro de un EvidencePack. Distingue fuentes externas, documentos del usuario, tiers, snapshots y estado de vigencia.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts; Subfase 0.6 - Politicas de fuentes, vigencia, conflicto e incertidumbre",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
    ]
  },
  "required": [
    "source_ref",
    "source_type",
    "tier",
    "title",
    "retrieved_at",
    "validity_status",
    "warnings",
    "metadata"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "pattern": "^F[0-9]+$|^D[0-9]+$"
    },
    "source_type": {
      "enum": [
        "norma",
        "jurisprudencia",
        "documento_usuario",
        "doctrina",
        "web",
        "institucional"
      ]
    },
    "tier": {
      "enum": [
        "TIER1_CANONICO",
        "TIER1_OFICIAL",
        "TIER1_STRUCTURED",
        "TIER2_CONFIABLE",
        "TIER3_SECUNDARIO",
        "USER_DOCUMENT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^snap_[A-Za-z0-9_-]+$"
    },
    "snapshot_unavailable_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "host_blocked_snapshot",
        "content_too_large",
        "transient_fetch_error",
        "legal_access_restricted",
        "dynamic_render_failed",
        "user_private_document_not_snapshotted",
        null
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "validity_status": {
      "enum": [
        "VIGENCIA_CONFIRMADA",
        "VIGENCIA_NO_CONFIRMADA",
        "POSIBLEMENTE_MODIFICADA",
        "DEROGADA_CONFIRMADA",
        "CONFLICTIVA",
        "NO_APLICA"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_ref": {
            "pattern": "^D[0-9]+$"
          }
        },
        "required": [
          "source_ref"
        ]
      },
      "then": {
        "properties": {
          "source_type": {
            "const": "documento_usuario"
          },
          "tier": {
            "const": "USER_DOCUMENT"
          },
          "validity_status": {
            "const": "NO_APLICA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_ref": {
            "pattern": "^F[0-9]+$"
          }
        },
        "required": [
          "source_ref"
        ]
      },
      "then": {
        "properties": {
          "source_type": {
            "not": {
              "const": "documento_usuario"
            }
          },
          "tier": {
            "not": {
              "const": "USER_DOCUMENT"
            }
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "required": [
            "snapshot_id"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^snap_[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "required": [
            "snapshot_unavailable_reason"
          ],
          "properties": {
            "snapshot_unavailable_reason": {
              "type": "string",
              "enum": [
                "host_blocked_snapshot",
                "content_too_large",
                "transient_fetch_error",
                "legal_access_restricted",
                "dynamic_render_failed",
                "user_private_document_not_snapshotted"
              ]
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^snap_[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "snapshot_id"
        ]
      },
      "then": {
        "properties": {
          "snapshot_unavailable_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshot_id": {
            "type": "null"
          }
        },
        "required": [
          "snapshot_id"
        ]
      },
      "then": {
        "required": [
          "snapshot_unavailable_reason"
        ],
        "properties": {
          "snapshot_unavailable_reason": {
            "type": "string",
            "enum": [
              "host_blocked_snapshot",
              "content_too_large",
              "transient_fetch_error",
              "legal_access_restricted",
              "dynamic_render_failed",
              "user_private_document_not_snapshotted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshot_unavailable_reason": {
            "type": "string",
            "enum": [
              "host_blocked_snapshot",
              "content_too_large",
              "transient_fetch_error",
              "legal_access_restricted",
              "dynamic_render_failed",
              "user_private_document_not_snapshotted"
            ]
          }
        },
        "required": [
          "snapshot_unavailable_reason"
        ]
      },
      "then": {
        "properties": {
          "snapshot_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshot_unavailable_reason": {
            "const": "user_private_document_not_snapshotted"
          }
        },
        "required": [
          "snapshot_unavailable_reason"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "tier": {
                "const": "USER_DOCUMENT"
              }
            },
            "required": [
              "tier"
            ]
          },
          {
            "properties": {
              "source_type": {
                "const": "documento_usuario"
              }
            },
            "required": [
              "source_type"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "norma"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "properties": {
          "validity_status": {
            "enum": [
              "VIGENCIA_CONFIRMADA",
              "VIGENCIA_NO_CONFIRMADA",
              "POSIBLEMENTE_MODIFICADA",
              "DEROGADA_CONFIRMADA",
              "CONFLICTIVA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validity_status": {
            "enum": [
              "VIGENCIA_CONFIRMADA",
              "DEROGADA_CONFIRMADA"
            ]
          }
        },
        "required": [
        "validity_status"
        ]
      },
      "then": {
        "properties": {
          "tier": {
            "enum": [
              "TIER1_CANONICO",
              "TIER1_OFICIAL",
              "TIER1_STRUCTURED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "TIER2_CONFIABLE",
              "TIER3_SECUNDARIO"
            ]
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "examples": [
