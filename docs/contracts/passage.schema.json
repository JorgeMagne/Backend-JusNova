{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/passage.schema.json",
  "title": "EvidencePassage",
  "description": "Pasaje localizable extraido de una fuente o documento. Es la unidad citable que conecta una cita con una fuente. El prefijo D/F de passage_ref debe coincidir con source_ref; la igualdad exacta del identificador completo se exige por Citation Policy.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts",
    "amendments": [
      "Subfase 0.14 - Sanitized warning bounds"
    ]
  },
  "required": [
    "passage_ref",
    "source_ref",
    "text",
    "locator",
    "extraction_method",
    "extraction_confidence",
    "warnings"
  ],
  "properties": {
    "passage_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^[FD][0-9]+:P[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^F[0-9]+$|^D[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "locator": {
      "type": "object",
      "required": [
        "page",
        "article",
        "section",
        "paragraph",
        "coordinates",
        "url_fragment"
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "article": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "(?:^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$)(?![\\s\\S])",
          "maxLength": 120
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "(?:^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$)(?![\\s\\S])",
          "maxLength": 240
        },
        "paragraph": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox_coordinates"
            },
            {
              "type": "null"
            }
          ]
        },
        "url_fragment": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "(?:^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$)(?![\\s\\S])",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "extraction_method": {
      "enum": [
        "native_text",
        "ocr",
        "html_parse",
        "pdf_parse",
        "manual_adapter",
        "model_vision",
        "unknown"
      ]
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "(?:^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$)(?![\\s\\S])"
      },
      "maxItems": 32
    }
  },
  "$defs": {
    "bbox_coordinates": {
      "type": "object",
      "description": "Bounding box cerrado dentro de la pagina o fragmento renderizado. La unidad concreta se define por el adaptador documental, pero la forma queda fija.",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "passage_ref": {
            "pattern": "(?:^D[0-9]+:P[0-9]+$)(?![\\s\\S])"
          }
        },
        "required": [
          "passage_ref"
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "pattern": "(?:^D[0-9]+$)(?![\\s\\S])"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passage_ref": {
            "pattern": "(?:^F[0-9]+:P[0-9]+$)(?![\\s\\S])"
          }
        },
        "required": [
          "passage_ref"
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "pattern": "(?:^F[0-9]+$)(?![\\s\\S])"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "text": "El recurso debe interponerse dentro del plazo previsto por la norma aplicable.",
      "locator": {
        "page": 4,
        "article": "Art. 274",
        "section": "Recurso de casacion",
        "paragraph": 2,
        "coordinates": null,
        "url_fragment": "#art274"
      },
      "extraction_method": "pdf_parse",
      "extraction_confidence": 0.93,
      "warnings": []
    }
  ],
  "x-invalid-examples": [
    {
      "passage_ref": "P1",
      "source_ref": "F1",
      "text": "",
      "locator": {},
      "extraction_method": "pdf_parse",
      "extraction_confidence": 1.2,
      "warnings": []
    },
    {
      "passage_ref": "F1:P1",
      "source_ref": "F1",
      "text": "Pasaje con coordenadas libres no cerradas.",
      "locator": {
        "page": 4,
        "article": null,
        "section": null,
        "paragraph": null,
        "coordinates": {
          "x": 10,
          "y": 20,
          "width": 100,
          "height": 40,
          "raw_payload": "no permitido"
        },
        "url_fragment": null
      },
      "extraction_method": "pdf_parse",
      "extraction_confidence": 0.9,
      "warnings": []
    }
  ],
  "x-policy-invalid-examples": [
    {
      "passage_ref": "F1:P1",
      "source_ref": "F2",
      "text": "Pasaje con prefijo consistente pero source_ref distinto al identificador del pasaje.",
      "locator": {
        "page": 1,
        "article": null,
        "section": null,
        "paragraph": null,
        "coordinates": null,
        "url_fragment": null
      },
      "extraction_method": "pdf_parse",
      "extraction_confidence": 0.9,
      "warnings": []
    }
  ]
}
