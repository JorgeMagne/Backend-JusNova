{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/conversation.schema.json",
  "title": "Conversation",
  "description": "Contrato documental minimo para una conversacion juridica en JusNova. No almacena verdad juridica ni sustituye CaseMemory, EvidencePack o TraceObject.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.9 - Conversacion, memoria, documentos y OCR"
  },
  "required": [
    "conversation_id",
    "organization_id",
    "owner_actor_ref",
    "owner_actor_type",
    "case_id",
    "title",
    "created_at",
    "updated_at",
    "status"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_actor_ref": {
      "type": "string",
      "pattern": "^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
    },
    "owner_actor_type": {
      "const": "user"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 180
    },
    "status": {
      "enum": [
        "active",
        "archived",
        "deleted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deleted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deleted_at"
        ],
        "properties": {
          "deleted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "deleted_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "conversation_id": "conv_001",
      "organization_id": "org_001",
