{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/raw-access-event.schema.json",
  "title": "RawAccessEvent",
  "description": "Evento de auditoria para acceso raw o elevado. No representa SUPPORT_VIEW normal y no almacena contenido crudo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.10 - Seguridad, privacidad y proveedores externos",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft",
      "Subfase 0.14 - Clasificacion heredada de TraceObject y RetrievalRun"
    ]
  },
  "required": [
    "raw_access_event_id",
    "organization_id",
    "resource_type",
    "resource_ref",
    "classification",
    "actor_ref",
    "actor_type",
    "access_role",
    "reason",
    "accessed_at",
    "visibility_level",
    "access_case_ref",
    "approved_by_ref"
  ],
  "properties": {
    "raw_access_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^rae_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^org_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "resource_type": {
      "enum": [
        "document",
        "document_evidence",
        "message",
        "trace",
        "model_call",
        "tool_call",
        "retrieval_run",
        "provider_call",
        "ocr_artifact",
        "embedding",
        "storage_object",
        "case_memory",
        "usage_event"
      ]
    },
    "resource_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "classification": {
      "enum": [
        "PUBLIC_LEGAL_SOURCE",
        "PUBLIC_LEGAL_QUERY",
        "PROVIDER_OPERATIONAL_METADATA",
        "BILLING_USAGE",
        "INTERNAL_TRACE_RESTRICTED",
        "SECURITY_AUDIT_RESTRICTED",
        "DERIVED_LEGAL_QUERY_RESTRICTED",
        "USER_MESSAGE_CONFIDENTIAL",
        "CASE_MEMORY_CONFIDENTIAL",
        "DOCUMENT_EVIDENCE_CONFIDENTIAL",
        "USER_DOCUMENT_CONFIDENTIAL"
      ]
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "support",
        "service"
      ]
    },
    "access_role": {
      "enum": [
        "security_auditor",
        "incident_responder",
        "system_job"
      ]
    },
    "reason": {
      "enum": [
        "incident_response",
        "legal_audit",
        "security_investigation",
        "user_request",
        "regulatory_request"
      ]
    },
    "accessed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "maxLength": 40
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "date-time",
      "maxLength": 40
    },
    "visibility_level": {
      "enum": [
        "INTERNAL_AUDIT",
        "RAW_INCIDENT_ACCESS"
      ]
    },
    "access_case_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^(inc|audit|req)_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "approved_by_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^(actor_hash_[A-Za-z0-9_-]+|support_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$)(?![\\s\\S])",
      "maxLength": 160
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "(?:^doc_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "document_version_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "(?:^docv_[A-Za-z0-9_-]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "passage_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "(?:^D[0-9]+:P[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "user"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "(?:^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$)(?![\\s\\S])"
          },
          "access_role": {
            "const": "security_auditor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "support"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "(?:^(support_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$)(?![\\s\\S])"
          },
          "access_role": {
            "enum": [
              "incident_responder",
              "security_auditor"
            ]
          },
          "visibility_level": {
            "const": "RAW_INCIDENT_ACCESS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "service"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "(?:^service_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "access_role": {
            "enum": [
              "system_job",
              "incident_responder"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "system"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "const": "system"
          },
          "access_role": {
            "const": "system_job"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "document_evidence"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "required": [
          "document_id",
          "document_version_id",
          "passage_ref"
        ],
        "properties": {
          "resource_ref": {
            "pattern": "(?:^de_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "const": "DOCUMENT_EVIDENCE_CONFIDENTIAL"
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?:^doc_[A-Za-z0-9_-]+$)(?![\\s\\S])",
            "maxLength": 160
          },
          "document_version_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?:^docv_[A-Za-z0-9_-]+$)(?![\\s\\S])",
            "maxLength": 160
          },
          "passage_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?:^D[0-9]+:P[0-9]+$)(?![\\s\\S])",
            "maxLength": 160
          }
        }
      },
      "else": {
        "properties": {
          "document_id": {
            "type": "null"
          },
          "document_version_id": {
            "type": "null"
          },
          "passage_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "document"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "properties": {
          "resource_ref": {
            "pattern": "(?:^doc_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "const": "USER_DOCUMENT_CONFIDENTIAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "message"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "properties": {
          "resource_ref": {
            "pattern": "(?:^msg_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "const": "USER_MESSAGE_CONFIDENTIAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "case_memory"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "properties": {
          "resource_ref": {
            "pattern": "(?:^case_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "const": "CASE_MEMORY_CONFIDENTIAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "usage_event"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "properties": {
          "resource_ref": {
            "pattern": "(?:^ue_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "const": "BILLING_USAGE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
            "const": "provider_call"
          }
        },
        "required": [
          "resource_type"
        ]
      },
      "then": {
        "properties": {
          "resource_ref": {
            "pattern": "(?:^pca_[A-Za-z0-9_-]+$)(?![\\s\\S])"
          },
          "classification": {
            "enum": [
              "PROVIDER_OPERATIONAL_METADATA",
              "SECURITY_AUDIT_RESTRICTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_type": {
