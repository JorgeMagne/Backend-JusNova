{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/case-memory.schema.json",
  "title": "CaseMemory",
  "description": "Memoria estructurada de caso para contexto operativo. No es evidencia juridica, no confirma vigencia y no sustituye EvidencePack, Source, Passage, Claim ni Citation.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.9 - Conversacion, memoria, documentos y OCR",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
    ]
  },
  "required": [
    "case_id",
    "organization_id",
    "jurisdiction",
    "memory_version",
    "legal_areas",
    "procedural_stage_code",
    "procedural_stage_label",
    "parties",
    "dates",
    "facts_asserted_by_user",
    "facts_supported_by_documents",
    "open_legal_questions",
    "source_history",
    "risk_flags",
    "contradictions",
    "updated_at"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^case_[A-Za-z0-9_-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^org_[A-Za-z0-9_-]+$"
    },
    "jurisdiction": {
      "const": "BO"
    },
    "memory_version": {
      "type": "integer",
      "minimum": 1
    },
    "legal_areas": {
      "type": "array",
      "items": {
        "enum": [
          "CIVIL",
          "PROCESAL_CIVIL",
          "PENAL",
          "PROCESAL_PENAL",
          "LABORAL",
          "CONSTITUCIONAL",
          "ADMINISTRATIVO",
          "TRIBUTARIO",
          "COMERCIAL",
          "FAMILIA",
          "NIÑEZ_ADOLESCENCIA",
          "AGROAMBIENTAL",
          "COACTIVO_FISCAL",
          "CONTENCIOSO_ADMINISTRATIVO",
          "REGULATORIO_SECTORIAL",
          "MUNICIPAL_AUTONOMICO",
          "NOTARIAL_REGISTRAL",
          "MIGRATORIO",
          "OTRO"
        ]
      },
      "uniqueItems": true
    },
    "procedural_stage_code": {
      "enum": [
        "pre_filing",
        "filing",
        "admitted",
        "evidence",
        "hearing",
        "appeal",
        "execution",
        "closed",
        "unknown"
      ]
    },
    "procedural_stage_label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_date"
      }
    },
    "facts_asserted_by_user": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user_asserted_fact"
      }
    },
    "facts_supported_by_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document_supported_fact"
      }
    },
    "open_legal_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_legal_question"
      }
    },
    "source_history": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(F[0-9]+|D[0-9]+|F[0-9]+:P[0-9]+|D[0-9]+:P[0-9]+)$"
      },
      "uniqueItems": true
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk_flag"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "actor_user_ref": {
      "type": "string",
      "pattern": "^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
    },
    "user_asserted_fact": {
      "type": "object",
      "required": [
        "fact_id",
        "text",
        "asserted_by_type",
        "asserted_by_ref",
        "asserted_at",
        "status",
        "confidence"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "asserted_by_type": {
          "const": "user"
        },
        "asserted_by_ref": {
          "$ref": "#/$defs/actor_user_ref"
        },
        "asserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "disputed",
            "withdrawn"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "document_supported_fact": {
      "type": "object",
      "required": [
        "fact_id",
        "text",
        "document_id",
        "document_version_id",
        "passage_refs"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^doc_[A-Za-z0-9_-]+$"
        },
        "document_version_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^docv_[A-Za-z0-9_-]+$"
        },
        "passage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^D[0-9]+:P[0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "open_legal_question": {
      "type": "object",
      "required": [
        "question_id",
        "text",
        "status",
        "created_at"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "blocked",
            "needs_research"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "risk_flag": {
      "type": "object",
      "required": [
        "risk_flag_id",
        "risk_type",
        "severity",
        "description",
        "created_at"
      ],
      "properties": {
        "risk_flag_id": {
          "type": "string",
          "minLength": 1
        },
        "risk_type": {
          "enum": [
            "deadline",
            "missing_document",
            "conflicting_fact",
            "low_evidence",
            "jurisdiction_unclear",
            "procedural_uncertainty",
            "document_quality",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "blocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "contradiction": {
      "type": "object",
      "required": [
        "contradiction_id",
        "description",
        "fact_refs",
        "status",
        "created_at"
      ],
      "properties": {
        "contradiction_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "needs_review"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "required": [
        "party_id",
        "role",
        "display_ref"
      ],
      "properties": {
        "party_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "client",
            "opposing_party",
            "court",
            "authority",
            "third_party",
            "unknown"
          ]
        },
        "display_ref": {
          "type": "string",
          "pattern": "^(party_ref_[A-Za-z0-9_-]+|actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
        }
      },
      "additionalProperties": false
    },
    "case_date": {
      "type": "object",
      "required": [
        "date_id",
        "date",
        "date_type",
        "source_type",
        "source_ref"
      ],
      "properties": {
        "date_id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "date_type": {
          "enum": [
            "event",
            "deadline",
            "filing",
            "notification",
            "hearing",
            "unknown"
          ]
        },
        "source_type": {
          "enum": [
            "user_asserted",
            "system_inferred",
            "evidence_ref"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(F[0-9]+|D[0-9]+|F[0-9]+:P[0-9]+|D[0-9]+:P[0-9]+)$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "evidence_ref"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^(F[0-9]+|D[0-9]+|F[0-9]+:P[0-9]+|D[0-9]+:P[0-9]+)$"
              }
            }
          },
          "else": {
            "properties": {
              "source_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
