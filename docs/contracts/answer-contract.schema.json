{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/answer-contract.schema.json",
  "title": "AnswerContract",
  "description": "Contrato de respuesta final. sources_used debe derivarse exclusivamente de citas reales en citations; esta relacion cruzada se valida por Citation Policy y validaciones negativas porque JSON Schema no puede garantizarla por si solo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts"
  },
  "required": [
    "answer_id",
    "answer_version",
    "evidence_pack_id",
    "jurisdiction",
    "sections",
    "claims",
    "citations",
    "sources_used",
    "warnings",
    "created_at"
  ],
  "properties": {
    "answer_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_version": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "const": "BO"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "content"
        ],
        "properties": {
          "section_id": {
            "enum": [
              "conclusion_operativa",
              "hechos_considerados",
              "fundamento_normativo",
              "jurisprudencia_relevante",
              "analisis_aplicado",
              "incertidumbres_vigencia_conflictos",
              "recomendacion_profesional",
              "fuentes_utilizadas"
            ]
          },
          "title": {
            "enum": [
              "Conclusion operativa",
              "Hechos considerados",
              "Fundamento normativo",
              "Jurisprudencia relevante",
              "Analisis aplicado",
              "Incertidumbres, vigencia y conflictos",
              "Recomendacion profesional",
              "Fuentes utilizadas"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./claim.schema.json"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "./citation.schema.json"
      }
    },
    "sources_used": {
      "type": "array",
      "description": "Debe contener solo source_ref citados por citations[].source_ref. Las fuentes no citadas son bibliografia decorativa y deben bloquear la respuesta por policy.",
      "items": {
        "type": "string",
        "pattern": "^F[0-9]+$|^D[0-9]+$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "answer_id": "ans_001",
      "answer_version": 1,
      "evidence_pack_id": "ep_001",
      "jurisdiction": "BO",
      "sections": [
        {
          "section_id": "conclusion_operativa",
          "title": "Conclusion operativa",
          "content": "Con la evidencia recuperada, el requisito formal debe verificarse contra la norma citada [F1:P1]."
        },
        {
          "section_id": "fuentes_utilizadas",
          "title": "Fuentes utilizadas",
          "content": "F1 - Codigo Procesal Civil."
        }
      ],
      "claims": [
        {
          "claim_id": "cl_001",
          "text": "El recurso de casacion exige cumplir los requisitos formales aplicables.",
          "claim_type": "procedimiento",
          "criticality": "high",
          "support_level": "direct",
          "citations": [
            "C1"
          ],
          "verification_status": "passed",
          "requires_human_review": false
        }
      ],
      "citations": [
        {
          "citation_ref": "C1",
          "passage_ref": "F1:P1",
          "source_ref": "F1",
          "status": "valid",
          "supports_claim_ids": [
            "cl_001"
          ],
          "auditor_notes": []
        }
      ],
      "sources_used": [
        "F1"
      ],
      "warnings": [
        "Vigencia no confirmada."
      ],
      "created_at": "2026-05-22T00:00:00Z"
    }
  ],
  "x-integrity-examples": [
    {
      "description": "Cadena minima claim -> citation -> passage -> source.",
      "claim": {
        "claim_id": "cl_001",
        "citations": [
          "C1"
        ]
      },
      "citation": {
        "citation_ref": "C1",
        "passage_ref": "F1:P1",
        "source_ref": "F1"
      },
      "passage": {
        "passage_ref": "F1:P1",
        "source_ref": "F1"
      },
      "source": {
        "source_ref": "F1",
        "tier": "TIER1_CANONICO"
      }
    }
  ],
  "x-invalid-examples": [
    {
      "answer_id": "ans_002",
      "answer_version": 1,
      "evidence_pack_id": "ep_001",
      "jurisdiction": "BO",
      "sections": [],
      "claims": [],
      "citations": [],
      "sources_used": [
        "F99"
      ],
      "warnings": [],
      "created_at": "2026-05-22T00:00:00Z"
    }
  ]
}
