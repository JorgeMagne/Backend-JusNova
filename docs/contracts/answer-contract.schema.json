{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/answer-contract.schema.json",
  "title": "AnswerContract",
  "description": "Contrato de respuesta final. Toda respuesta final requiere trace_id. sources_used debe derivarse exclusivamente de citas reales en citations; esta relacion cruzada se valida por Citation Policy y validaciones negativas porque JSON Schema no puede garantizarla por si solo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft",
      "Subfase 0.14 - Claim completeness hardening"
    ]
  },
  "x-tenant-policy": {
    "description": "JSON Schema valida la forma de Claim y Citation, pero la igualdad entre organization_id del AnswerContract y sus subobjetos es una regla custom obligatoria.",
    "same_organization_id": [
      "claims[].organization_id",
      "citations[].organization_id"
    ]
  },
  "x-claim-completeness-policy": {
    "description": "ClaimCompletenessValidator es obligatorio antes de publicar. Debe comprobar que toda afirmacion juridica critica visible en sections esta representada por un Claim semanticamente equivalente y que no existe Claim publicado cuyo texto diverja de la afirmacion visible que representa. JSON Schema valida forma local, no completitud semantica del texto.",
    "critical_claim_predicate": "criticality=high OR claim_type in plazo|requisito|competencia|causal|procedimiento|norma|jurisprudencia|vigencia",
    "failure_code": "critical_assertion_unmapped"
  },
  "required": [
    "answer_id",
    "organization_id",
    "answer_version",
    "trace_id",
    "evidence_pack_id",
    "jurisdiction",
    "sections",
    "claims",
    "citations",
    "sources_used",
    "warnings",
    "created_at"
  ],
  "properties": {
    "answer_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ans_[A-Za-z0-9_-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^org_[A-Za-z0-9_-]+$"
    },
    "answer_version": {
      "type": "integer",
      "minimum": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "evidence_pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ep_[A-Za-z0-9_-]+$"
    },
    "jurisdiction": {
      "type": "string",
      "const": "BO"
    },
    "sections": {
      "type": "object",
      "description": "Estructura visible estandar de respuesta juridica compleja. Cada clave canonica fija su titulo para impedir pares section_id/title incoherentes.",
      "required": [
        "conclusion_operativa",
        "hechos_considerados",
        "fundamento_normativo",
        "jurisprudencia_relevante",
        "analisis_aplicado",
        "incertidumbres_vigencia_conflictos",
        "recomendacion_profesional",
        "fuentes_utilizadas"
      ],
      "properties": {
        "conclusion_operativa": {
          "$ref": "#/$defs/section_conclusion_operativa"
        },
        "hechos_considerados": {
          "$ref": "#/$defs/section_hechos_considerados"
        },
        "fundamento_normativo": {
          "$ref": "#/$defs/section_fundamento_normativo"
        },
        "jurisprudencia_relevante": {
          "$ref": "#/$defs/section_jurisprudencia_relevante"
        },
        "analisis_aplicado": {
          "$ref": "#/$defs/section_analisis_aplicado"
        },
        "incertidumbres_vigencia_conflictos": {
          "$ref": "#/$defs/section_incertidumbres_vigencia_conflictos"
        },
        "recomendacion_profesional": {
          "$ref": "#/$defs/section_recomendacion_profesional"
        },
        "fuentes_utilizadas": {
          "$ref": "#/$defs/section_fuentes_utilizadas"
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./claim.schema.json"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "./citation.schema.json"
      }
    },
    "sources_used": {
      "type": "array",
      "description": "Debe contener solo source_ref citados por citations[].source_ref. Las fuentes no citadas son bibliografia decorativa y deben bloquear la respuesta por policy.",
      "items": {
        "type": "string",
        "pattern": "^F[0-9]+$|^D[0-9]+$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "section_conclusion_operativa": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Conclusion operativa"
        }
      }
    },
    "section_hechos_considerados": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Hechos considerados"
        }
      }
    },
    "section_fundamento_normativo": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Fundamento normativo"
        }
      }
    },
    "section_jurisprudencia_relevante": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Jurisprudencia relevante"
        }
      }
    },
    "section_analisis_aplicado": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Analisis aplicado"
        }
      }
    },
    "section_incertidumbres_vigencia_conflictos": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Incertidumbres, vigencia y conflictos"
        }
      }
    },
    "section_recomendacion_profesional": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Recomendacion profesional"
        }
      }
    },
    "section_fuentes_utilizadas": {
      "$ref": "#/$defs/section_base",
      "properties": {
        "title": {
          "const": "Fuentes utilizadas"
        }
      }
    },
    "section_base": {
      "type": "object",
      "required": [
        "title",
        "content"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
