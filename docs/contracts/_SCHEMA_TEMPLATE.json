{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/schema-template.schema.json",
  "title": "SchemaTemplate",
  "description": "Template for JusNova internal JSON Schemas. Replace title, id, required fields, properties, examples, and invalid_examples when creating a concrete contract.",
  "type": "object",
  "x-governance": {
    "document_status": "Draft",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Fase 0.0 - Plantilla de contrato JSON Schema"
  },
  "required": [
    "id",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "example_001",
      "created_at": "2026-05-22T00:00:00Z"
    }
  ],
  "x-invalid-examples": [
    {
      "created_at": "2026-05-22T00:00:00Z"
    }
  ]
}

