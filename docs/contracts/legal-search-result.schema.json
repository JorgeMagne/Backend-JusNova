{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/legal-search-result.schema.json",
  "title": "LegalSearchResult",
  "description": "Resultado normalizado de discovery o adaptador oficial. No es citable hasta fetch, extraction, pasaje y snapshot o razon de imposibilidad de snapshot.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.5 - Live Legal Search Engine Contract; Subfase 0.6 - Politicas de fuentes, vigencia, conflicto e incertidumbre"
  },
  "required": [
    "result_id",
    "title",
    "url",
    "tier",
    "source_type",
    "jurisdiction",
    "relevance_score",
    "authority_score",
    "jurisdiction_score",
    "freshness_score",
    "extractability_score",
    "source_health_score",
    "extraction_status",
    "citation_eligible",
    "retrieved_at",
    "warnings"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "tier": {
      "enum": [
        "TIER1_CANONICO",
        "TIER1_OFICIAL",
        "TIER1_STRUCTURED",
        "TIER2_CONFIABLE",
        "TIER3_SECUNDARIO",
        "USER_DOCUMENT"
      ]
    },
    "source_type": {
      "enum": [
        "norma",
        "jurisprudencia",
        "documento_usuario",
        "doctrina",
        "web",
        "institucional"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "const": "BO"
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "snippet": {
      "type": [
        "string",
        "null"
      ]
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "authority_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "jurisdiction_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extractability_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_health_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "final_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extraction_status": {
      "enum": [
        "not_fetched",
        "fetched",
        "extracted",
        "failed",
        "partial"
      ]
    },
    "citation_eligible": {
      "type": "boolean"
    },
    "passage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[FD][0-9]+:P[0-9]+$"
      },
      "uniqueItems": true
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "snapshot_unavailable_reason": {
      "enum": [
        "host_blocked_snapshot",
        "content_too_large",
        "transient_fetch_error",
        "legal_access_restricted",
        "dynamic_render_failed",
        "user_private_document_not_snapshotted"
      ]
    },
    "validity_status": {
      "enum": [
        "VIGENCIA_CONFIRMADA",
        "VIGENCIA_NO_CONFIRMADA",
        "POSIBLEMENTE_MODIFICADA",
        "DEROGADA_CONFIRMADA",
        "CONFLICTIVA",
        "NO_APLICA"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "documento_usuario"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "validity_status"
        ],
        "properties": {
          "tier": {
            "const": "USER_DOCUMENT"
          },
          "validity_status": {
            "const": "NO_APLICA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "USER_DOCUMENT"
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "required": [
          "validity_status"
        ],
        "properties": {
          "source_type": {
            "const": "documento_usuario"
          },
          "validity_status": {
            "const": "NO_APLICA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "norma"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "validity_status"
        ],
        "properties": {
          "validity_status": {
            "enum": [
              "VIGENCIA_CONFIRMADA",
              "VIGENCIA_NO_CONFIRMADA",
              "POSIBLEMENTE_MODIFICADA",
              "DEROGADA_CONFIRMADA",
              "CONFLICTIVA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction_status": {
            "const": "extracted"
          }
        },
        "required": [
          "extraction_status"
        ]
      },
      "then": {
        "required": [
          "passage_refs"
        ],
        "properties": {
          "passage_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "snapshot_id",
          "snapshot_unavailable_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "snapshot_unavailable_reason": {
            "const": "user_private_document_not_snapshotted"
          }
        },
        "required": [
          "snapshot_unavailable_reason"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "tier": {
                "const": "USER_DOCUMENT"
              }
            },
            "required": [
              "tier"
            ]
          },
          {
            "properties": {
              "source_type": {
                "const": "documento_usuario"
              }
            },
            "required": [
              "source_type"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "citation_eligible": {
            "const": true
          }
        },
        "required": [
          "citation_eligible"
        ]
      },
      "then": {
        "required": [
          "passage_refs"
        ],
        "oneOf": [
          {
            "required": [
              "snapshot_id"
            ],
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "snapshot_unavailable_reason"
            ]
          }
        ],
        "properties": {
          "extraction_status": {
            "const": "extracted"
          },
          "passage_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "passage_refs"
        ],
        "properties": {
          "passage_refs": {
            "minItems": 1
          },
          "snapshot_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "snapshot_unavailable_reason"
        ]
      }
    }
  ],
  "examples": [
    {
      "result_id": "lsr_001",
      "title": "Sentencia Constitucional Plurinacional sobre debido proceso",
