{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/message.schema.json",
  "title": "Message",
  "description": "Contrato minimo para mensajes persistidos de conversacion. Message puede guardar contenido conversacional, pero TraceObject y logs solo deben referenciarlo por ID/hash.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.9 - Conversacion, memoria, documentos y OCR"
  },
  "required": [
    "message_id",
    "conversation_id",
    "organization_id",
    "actor_ref",
    "actor_type",
    "role",
    "message_kind",
    "content",
    "content_hash",
    "attachments",
    "created_at"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "service"
      ]
    },
    "role": {
      "enum": [
        "user",
        "assistant",
        "system_status",
        "tool_status"
      ]
    },
    "message_kind": {
      "enum": [
        "user_input",
        "assistant_final",
        "assistant_clarification",
        "system_notice",
        "tool_progress"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "answer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "answer_version_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document_attachment"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "document_attachment": {
      "type": "object",
      "required": [
        "attachment_id",
        "attachment_type",
        "status",
        "document_id",
        "document_version_id",
        "source_ref"
      ],
      "properties": {
        "attachment_id": {
          "type": "string",
          "minLength": 1
        },
        "attachment_type": {
          "const": "document"
        },
        "status": {
          "const": "processed"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "document_version_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "pattern": "^D[0-9]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "user"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "system"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "const": "system"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "service"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^service_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "user"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "user_input"
          },
          "actor_type": {
            "const": "user"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "assistant"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "enum": [
              "assistant_final",
              "assistant_clarification"
            ]
          },
          "actor_type": {
            "const": "service"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "system_status"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "system_notice"
          },
          "actor_type": {
            "enum": [
              "system",
              "service"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "tool_status"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "tool_progress"
          },
          "actor_type": {
            "const": "service"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_kind": {
            "const": "assistant_final"
          }
        },
        "required": [
          "message_kind"
        ]
      },
      "then": {
        "required": [
          "answer_id",
          "trace_id",
          "answer_version_ref"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "answer_version_ref": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "answer_id": {
            "type": "null"
          },
          "trace_id": {
            "type": "null"
          },
          "answer_version_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_kind": {
            "const": "user_input"
          }
        },
        "required": [
          "message_kind"
        ]
      },
      "else": {
        "properties": {
          "attachments": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "examples": [
    {
      "message_id": "msg_001",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "actor_hash_abogado_001",
      "actor_type": "user",
      "role": "user",
      "message_kind": "user_input",
      "content": "Necesito revisar este contrato adjunto.",
      "content_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "answer_id": null,
      "trace_id": null,
      "answer_version_ref": null,
      "attachments": [
        {
          "attachment_id": "att_001",
          "attachment_type": "document",
          "status": "processed",
          "document_id": "doc_001",
          "document_version_id": "docv_001",
          "source_ref": "D1"
        }
      ],
      "created_at": "2026-05-24T10:00:00Z"
    },
    {
      "message_id": "msg_002",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "service_answer_generator",
      "actor_type": "service",
      "role": "assistant",
      "message_kind": "assistant_final",
      "content": "Con la evidencia disponible, corresponde una respuesta parcial.",
      "content_hash": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "answer_id": "ans_001",
      "trace_id": "tr_001",
      "answer_version_ref": "av_001",
      "attachments": [],
      "created_at": "2026-05-24T10:00:10Z"
    }
  ],
  "x-invalid-examples": [
    {
      "message_id": "msg_bad_support",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "support_hash_001",
      "actor_type": "support",
      "role": "assistant",
      "message_kind": "assistant_final",
      "content": "Respuesta final.",
      "content_hash": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
      "answer_id": "ans_001",
      "trace_id": "tr_001",
      "answer_version_ref": "av_001",
      "attachments": [],
      "created_at": "2026-05-24T10:00:10Z"
    },
    {
      "message_id": "msg_bad_answer_ref_on_user",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "actor_hash_abogado_001",
      "actor_type": "user",
      "role": "user",
      "message_kind": "user_input",
      "content": "Pregunta.",
      "content_hash": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
      "answer_id": "ans_001",
      "trace_id": null,
      "answer_version_ref": null,
      "attachments": [],
      "created_at": "2026-05-24T10:00:00Z"
    },
    {
      "message_id": "msg_bad_attachment_status",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "actor_hash_abogado_001",
      "actor_type": "user",
      "role": "user",
      "message_kind": "user_input",
      "content": "Adjunto documento.",
      "content_hash": "sha256:5555555555555555555555555555555555555555555555555555555555555555",
      "answer_id": null,
      "trace_id": null,
      "answer_version_ref": null,
      "attachments": [
        {
          "attachment_id": "att_001",
          "attachment_type": "document",
          "status": "processing",
          "document_id": "doc_001",
          "document_version_id": "docv_001",
          "source_ref": "D1"
        }
      ],
      "created_at": "2026-05-24T10:00:00Z"
    }
  ],
  "x-policy-invalid-examples": [
    {
      "message_id": "msg_hash_mismatch",
      "conversation_id": "conv_001",
      "organization_id": "org_001",
      "actor_ref": "actor_hash_abogado_001",
      "actor_type": "user",
      "role": "user",
      "message_kind": "user_input",
      "content": "El hash no corresponde a estos bytes UTF-8 exactos.",
      "content_hash": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
      "answer_id": null,
      "trace_id": null,
      "answer_version_ref": null,
      "attachments": [],
      "created_at": "2026-05-24T10:00:00Z"
    }
  ]
}
