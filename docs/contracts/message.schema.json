{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/message.schema.json",
  "title": "Message",
  "description": "Contrato minimo para mensajes persistidos de conversacion. Message puede guardar contenido conversacional, pero TraceObject y logs solo deben referenciarlo por ID/hash.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.9 - Conversacion, memoria, documentos y OCR"
  },
  "required": [
    "message_id",
    "conversation_id",
    "organization_id",
    "actor_ref",
    "actor_type",
    "role",
    "message_kind",
    "content",
    "content_hash",
    "attachments",
    "created_at"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "service"
      ]
    },
    "role": {
      "enum": [
        "user",
        "assistant",
        "system_status",
        "tool_status"
      ]
    },
    "message_kind": {
      "enum": [
        "user_input",
        "assistant_final",
        "assistant_clarification",
        "system_notice",
        "tool_progress"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "answer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "answer_version_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document_attachment"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "document_attachment": {
      "type": "object",
      "required": [
        "attachment_id",
        "attachment_type",
        "status",
        "document_id",
        "document_version_id",
        "source_ref"
      ],
      "properties": {
        "attachment_id": {
          "type": "string",
          "minLength": 1
        },
        "attachment_type": {
          "const": "document"
        },
        "status": {
          "const": "processed"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "document_version_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "pattern": "^D[0-9]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "user"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "system"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "const": "system"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "service"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^service_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "user"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "user_input"
          },
          "actor_type": {
            "const": "user"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "assistant"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "enum": [
              "assistant_final",
              "assistant_clarification"
            ]
          },
          "actor_type": {
            "const": "service"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "system_status"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "system_notice"
          },
          "actor_type": {
            "enum": [
              "system",
              "service"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "tool_status"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "message_kind": {
            "const": "tool_progress"
          },
          "actor_type": {
            "const": "service"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_kind": {
            "const": "assistant_final"
          }
        },
        "required": [
          "message_kind"
        ]
      },
      "then": {
        "required": [
          "answer_id",
          "trace_id",
          "answer_version_ref"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "answer_version_ref": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "answer_id": {
            "type": "null"
          },
          "trace_id": {
            "type": "null"
          },
          "answer_version_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_kind": {
            "const": "user_input"
          }
        },
        "required": [
          "message_kind"
        ]
      },
      "else": {
        "properties": {
          "attachments": {
            "maxItems": 0
          }
        }
      }
    }
  ],
