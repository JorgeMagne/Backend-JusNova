      "plan_code": "ESTUDIO",
      "complexity": "INVESTIGACION",
      "created_at": "2026-05-24T00:00:00Z",
      "discovery_calls_max": 8,
      "fetch_urls_max": 20,
      "ocr_pages_inline_max": 20,
      "reformulations_max": 3,
      "tool_rounds_max": 6,
      "time_budget_ms": 300000,
      "output_tokens_cap": 4000,
      "research_credit_cost": 2,
      "async_allowed": true
