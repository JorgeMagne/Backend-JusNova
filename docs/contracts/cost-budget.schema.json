      "tool_rounds_max": 2,
      "time_budget_ms": 45000,
      "output_tokens_cap": 900,
      "research_credit_cost": 0,
      "async_allowed": false
    },
    {
      "cost_budget_id": "cb_estudio_investigacion_v080",
