{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/cost-budget.schema.json",
  "title": "CostBudget",
  "description": "Presupuesto operativo aplicado por el Cost Governor. Define limites tecnicos por complejidad y plan neutral; no representa costo observado ni facturacion.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.8 - Cost Governor, planes y presupuestos",
    "amendments": [
      "Subfase 0.9 - Conversacion, memoria, documentos y OCR fixture alignment",
      "Subfase 0.10 - Seguridad, privacidad y proveedores externos",
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft fixture alignment"
    ]
  },
  "required": [
    "cost_budget_id",
    "cost_budget_version",
    "plan_code",
    "complexity",
    "created_at",
    "discovery_calls_max",
    "fetch_urls_max",
    "ocr_pages_inline_max",
    "reformulations_max",
    "tool_rounds_max",
    "time_budget_ms",
    "output_tokens_cap",
    "research_credit_cost",
    "async_allowed"
  ],
  "properties": {
    "cost_budget_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^cb_(profesional|pro_plus|estudio|enterprise)_(simple|medio|complejo|investigacion)_v[0-9]{3}$)(?![\\s\\S])",
      "maxLength": 160
    },
    "cost_budget_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?:^cost-budget-v[0-9]+\\.[0-9]+\\.[0-9]+$)(?![\\s\\S])",
      "maxLength": 160
    },
    "plan_code": {
      "enum": [
        "PROFESIONAL",
        "PRO_PLUS",
        "ESTUDIO",
        "ENTERPRISE"
      ]
    },
    "complexity": {
      "enum": [
        "SIMPLE",
        "MEDIO",
        "COMPLEJO",
        "INVESTIGACION"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "maxLength": 40
    },
    "discovery_calls_max": {
      "type": "integer",
      "minimum": 0
    },
    "fetch_urls_max": {
      "type": "integer",
      "minimum": 0
    },
    "ocr_pages_inline_max": {
      "type": "integer",
      "minimum": 0
    },
    "reformulations_max": {
      "type": "integer",
      "minimum": 0
    },
    "tool_rounds_max": {
      "type": "integer",
      "minimum": 0
    },
    "time_budget_ms": {
      "type": "integer",
      "minimum": 1
    },
    "output_tokens_cap": {
      "type": "integer",
      "minimum": 1
    },
    "research_credit_cost": {
      "type": "integer",
      "minimum": 0
    },
    "async_allowed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "complexity": {
            "const": "SIMPLE"
