{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/evidence-pack.schema.json",
  "title": "EvidencePack",
  "description": "Paquete normalizado de evidencia que alimenta la generacion de respuesta. Es la unica base permitida para claims juridicos criticos. retrieval_run_id puede ser null para packs manuales o documentales que no provienen de retrieval vivo.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.4 - Evidence, Answer, Citation y Claim Contracts",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft",
      "Subfase 0.14 - Retrieval cardinality and EvidenceQuality alignment"
    ]
  },
  "x-tenant-policy": {
    "description": "EvidencePack.organization_id debe coincidir con LegalSearchQuery resuelta por query_id y, cuando retrieval_run_id no sea null, con RetrievalRun; fuentes documentales privadas tambien deben resolver al mismo tenant.",
    "same_organization_id_refs": [
      "query_id -> LegalSearchQuery.organization_id",
      "retrieval_run_id != null -> RetrievalRun.organization_id",
      "sources[].source_ref=D# -> DocumentEvidence.organization_id",
      "passages[].passage_ref=D#:P# -> DocumentEvidence.organization_id"
    ]
  },
  "required": [
    "evidence_pack_id",
    "organization_id",
    "query_id",
    "retrieval_run_id",
    "jurisdiction",
    "legal_area",
    "sources",
    "passages",
    "quality",
    "created_at"
  ],
  "properties": {
    "evidence_pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ep_[A-Za-z0-9_-]+$"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^q_[A-Za-z0-9_-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^org_[A-Za-z0-9_-]+$"
    },
    "retrieval_run_id": {
      "description": "Ref al retrieval vivo que produjo el pack. null es valido exclusivamente cuando el pack es manual o documental y no existe RetrievalRun.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^rr_[A-Za-z0-9_-]+$"
    },
    "jurisdiction": {
      "type": "string",
      "const": "BO"
    },
    "legal_area": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CIVIL",
          "PROCESAL_CIVIL",
          "PENAL",
          "PROCESAL_PENAL",
          "LABORAL",
          "CONSTITUCIONAL",
          "ADMINISTRATIVO",
          "TRIBUTARIO",
          "COMERCIAL",
          "FAMILIA",
          "NIÑEZ_ADOLESCENCIA",
          "AGROAMBIENTAL",
          "COACTIVO_FISCAL",
          "CONTENCIOSO_ADMINISTRATIVO",
          "REGULATORIO_SECTORIAL",
          "MUNICIPAL_AUTONOMICO",
          "NOTARIAL_REGISTRAL",
          "MIGRATORIO",
          "OTRO"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "./source.schema.json"
      },
      "minItems": 0
    },
    "passages": {
      "type": "array",
      "items": {
        "$ref": "./passage.schema.json"
      },
      "minItems": 0
    },
    "quality": {
      "$ref": "./evidence-quality.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "properties": {
              "overall": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              }
            },
            "required": [
              "overall"
            ]
          }
        },
        "required": [
          "quality"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          },
          "passages": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "sources": {
                "maxItems": 0
              }
            },
            "required": [
              "sources"
            ]
          },
          {
            "properties": {
              "passages": {
                "maxItems": 0
              }
            },
            "required": [
              "passages"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "overall": {
                "const": "NONE"
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "evidence_pack_id": "ep_001",
      "organization_id": "org_001",
      "query_id": "q_001",
      "retrieval_run_id": "rr_001",
      "jurisdiction": "BO",
      "legal_area": [
