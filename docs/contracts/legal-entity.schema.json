{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/legal-entity.schema.json",
  "title": "LegalEntity",
  "description": "Entidad juridica detectada o resuelta para guiar busqueda viva. No prueba vigencia ni autoridad por si sola.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-22",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.5 - Live Legal Search Engine Contract",
    "amendments": [
      "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
    ]
  },
  "required": [
    "entity_id",
    "entity_type",
    "value",
    "confidence",
    "needs_disambiguation"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ent_[A-Za-z0-9_-]+$"
    },
    "entity_type": {
      "enum": [
        "ley",
        "decreto_supremo",
        "resolucion",
        "auto_supremo",
        "scp",
        "sentencia",
        "codigo",
        "concepto",
        "institucion",
        "articulo",
        "otro"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2100
    },
    "authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_disambiguation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "entity_id": "ent_001",
      "entity_type": "ley",
      "value": "Ley 439",
      "number": "439",
      "year": 2013,
      "authority": "Asamblea Legislativa Plurinacional",
      "confidence": 0.94,
      "needs_disambiguation": false
    }
  ],
  "x-invalid-examples": [
    {
      "entity_id": "entity-002",
      "entity_type": "ley",
      "value": "Ley 439",
      "number": "439",
      "year": 2013,
      "authority": "Asamblea Legislativa Plurinacional",
      "confidence": 0.94,
      "needs_disambiguation": false
    },
    {
      "entity_id": "ent_002",
      "entity_type": "norma_desconocida",
      "value": "Ley 439",
      "confidence": 1.2,
      "needs_disambiguation": false
    }
  ]
}
