{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "description": "Envelope cerrado para errores API de JusNova. No transporta contenido crudo de usuario, documentos, OCR, providers ni stack traces.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.11 - Modelo de datos conceptual y APIs draft"
  },
  "required": [
    "error_code",
    "safe_message_code",
    "message",
    "severity",
    "request_id",
    "retryable",
    "user_visible",
    "created_at"
  ],
  "properties": {
    "error_code": {
      "enum": [
        "validation_error",
        "not_found",
        "auth_required",
        "forbidden",
        "tenant_mismatch",
        "conflict",
        "rate_limited",
        "payload_too_large",
        "unsupported_file_type",
        "budget_exhausted",
        "research_credit_required",
        "policy_blocked",
        "prompt_injection_blocked",
        "unsupported_critical_claim",
        "evidence_insufficient",
        "document_processing_required",
        "document_processing_failed",
        "provider_unavailable",
        "storage_unavailable",
        "timeout",
        "internal_error"
      ]
    },
    "safe_message_code": {
      "enum": [
        "invalid_request",
        "resource_not_found",
        "authentication_required",
        "access_denied",
        "tenant_access_denied",
        "resource_conflict",
        "too_many_requests",
        "payload_too_large_safe",
        "file_type_not_supported",
        "budget_limit_reached",
        "research_credit_needed",
        "policy_blocked_safe",
        "prompt_injection_blocked_safe",
        "critical_claim_not_supported",
        "insufficient_evidence",
        "document_needs_processing",
        "document_processing_error",
        "provider_temporarily_unavailable",
        "storage_temporarily_unavailable",
        "request_timeout",
        "unexpected_error"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^rq_[A-Za-z0-9_-]+$"
    },
    "retryable": {
      "type": "boolean"
    },
    "user_visible": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^conv_[A-Za-z0-9_-]+$"
    },
    "answer_id": {
      "type": "string",
      "pattern": "^ans_[A-Za-z0-9_-]+$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]+$"
    },
    "provider_call_audit_id": {
      "type": "string",
      "pattern": "^pca_[A-Za-z0-9_-]+$"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "resource_type": {
          "enum": [
            "conversation",
            "message",
            "case",
            "case_memory",
            "document",
            "document_version",
            "document_evidence",
            "trace",
            "model_call",
            "tool_call",
            "retrieval_run",
            "provider_call",
            "usage_event",
            "answer",
            "answer_version",
            "evidence_pack",
            "source",
            "passage",
            "subscription",
            "research_credit"
          ]
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1
        },
        "parent_resource_type": {
          "enum": [
            "evidence_pack",
            "answer_version"
          ]
        },
        "parent_resource_ref": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 120
        },
        "limit_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 80
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "anyOf": [
              {
                "description": "Codigo simbolico seguro sin slash.",
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "description": "MIME type de upload permitido por catalogo cerrado.",
                "enum": [
                  "application/pdf",
                  "application/msword",
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                  "image/jpeg",
                  "image/png",
                  "image/tiff",
                  "image/webp",
                  "text/plain"
                ]
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "resource_type": [
          "resource_ref"
        ],
        "resource_ref": [
          "resource_type"
        ],
        "parent_resource_type": [
          "parent_resource_ref",
          "resource_type",
          "resource_ref"
        ],
        "parent_resource_ref": [
          "parent_resource_type",
          "resource_type",
          "resource_ref"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "required": [
              "resource_ref"
            ]
          }
        },
        {
          "if": {
            "required": [
              "resource_ref"
            ]
          },
          "then": {
            "required": [
              "resource_type"
            ]
          }
        },
        {
          "if": {
            "required": [
              "parent_resource_type"
            ]
          },
          "then": {
            "required": [
              "parent_resource_ref",
              "resource_type",
              "resource_ref"
            ]
          }
        },
        {
          "if": {
            "required": [
              "parent_resource_ref"
            ]
          },
          "then": {
            "required": [
              "parent_resource_type",
              "resource_type",
              "resource_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "conversation"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^conv_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "message"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^msg_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "case"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^case_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "case_memory"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^case_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "document"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^doc_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "document_version"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^docv_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "document_evidence"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^de_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "trace"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^tr_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "model_call"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^mc_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "tool_call"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^tc_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "retrieval_run"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^rr_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "provider_call"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^pca_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "usage_event"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^ue_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "answer"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^ans_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "answer_version"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^av_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "evidence_pack"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^ep_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "source"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "required": [
              "parent_resource_type",
              "parent_resource_ref"
            ],
            "properties": {
              "resource_ref": {
                "pattern": "^(F[0-9]+|D[0-9]+)$"
              },
              "parent_resource_type": {
                "const": "evidence_pack"
              },
              "parent_resource_ref": {
                "pattern": "^ep_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "passage"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "required": [
              "parent_resource_type",
              "parent_resource_ref"
            ],
            "properties": {
              "resource_ref": {
                "pattern": "^(F[0-9]+:P[0-9]+|D[0-9]+:P[0-9]+)$"
              },
              "parent_resource_type": {
                "const": "evidence_pack"
              },
              "parent_resource_ref": {
                "pattern": "^ep_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "subscription"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^sub_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "research_credit"
              }
            },
            "required": [
              "resource_type"
            ]
          },
          "then": {
            "properties": {
              "resource_ref": {
                "pattern": "^rc_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parent_resource_type": {
                "const": "evidence_pack"
              }
            },
            "required": [
              "parent_resource_type"
            ]
          },
          "then": {
            "properties": {
              "parent_resource_ref": {
                "pattern": "^ep_[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parent_resource_type": {
                "const": "answer_version"
              }
            },
            "required": [
              "parent_resource_type"
            ]
          },
          "then": {
            "properties": {
              "parent_resource_ref": {
                "pattern": "^av_[A-Za-z0-9_-]+$"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "validation_error"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "invalid_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "not_found"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "resource_not_found"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "auth_required"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "authentication_required"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "forbidden"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "access_denied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "tenant_mismatch"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "tenant_access_denied"
          },
          "severity": {
            "const": "critical"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "conflict"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "resource_conflict"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "rate_limited"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "required": [
          "metadata"
        ],
        "properties": {
          "safe_message_code": {
            "const": "too_many_requests"
          },
          "retryable": {
            "const": true
          },
          "metadata": {
            "required": [
              "retry_after_seconds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "payload_too_large"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "payload_too_large_safe"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "unsupported_file_type"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "file_type_not_supported"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "budget_exhausted"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "budget_limit_reached"
          },
          "user_visible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "research_credit_required"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "research_credit_needed"
          },
          "user_visible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "policy_blocked"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "policy_blocked_safe"
          },
          "severity": {
            "const": "critical"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "prompt_injection_blocked"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "prompt_injection_blocked_safe"
          },
          "severity": {
            "const": "critical"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "unsupported_critical_claim"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "critical_claim_not_supported"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "evidence_insufficient"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "insufficient_evidence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "document_processing_required"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "document_needs_processing"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "document_processing_failed"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "document_processing_error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "provider_unavailable"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "provider_temporarily_unavailable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "storage_unavailable"
          }
        },
        "required": [
          "error_code"
        ]
      },
      "then": {
        "properties": {
          "safe_message_code": {
            "const": "storage_temporarily_unavailable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "timeout"
          }
        },
        "required": [
          "error_code"
