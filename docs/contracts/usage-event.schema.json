{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/usage-event.schema.json",
  "title": "UsageEvent",
  "description": "Evento cerrado del Usage Ledger para auditar consumo tecnico, creditos y cuota de plan sin guardar PII directa ni metadata libre.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.8 - Cost Governor, planes y presupuestos"
  },
  "required": [
    "usage_event_id",
    "organization_id",
    "actor_ref",
    "actor_type",
    "plan_code",
    "billing_period",
    "event_scope",
    "event_type",
    "unit",
    "quantity",
    "created_at"
  ],
  "properties": {
    "usage_event_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(system|actor_hash_[A-Za-z0-9_-]+|support_hash_[A-Za-z0-9_-]+|service_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$",
      "allOf": [
        {
          "not": {
            "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+"
          }
        },
        {
          "not": {
            "pattern": "^\\+?[0-9][0-9\\s-]{5,}$"
          }
        }
      ]
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "support",
        "service"
      ]
    },
    "plan_code": {
      "enum": [
        "PROFESIONAL",
        "PRO_PLUS",
        "ESTUDIO",
        "ENTERPRISE"
      ]
    },
    "billing_period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "event_scope": {
      "enum": [
        "execution",
        "organization_period"
      ]
    },
    "event_type": {
      "enum": [
        "standard_query",
        "complex_query",
        "research_credit_used",
        "discovery_call",
        "fetch",
        "ocr_page",
        "document_processed",
        "model_input_tokens",
        "model_output_tokens",
        "storage_mb_day"
      ]
    },
    "unit": {
      "enum": [
        "query",
        "credit",
        "call",
        "fetch",
        "page",
        "document",
        "token",
        "mb_day"
      ]
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "complexity": {
      "enum": [
        "SIMPLE",
        "MEDIO",
        "COMPLEJO",
        "INVESTIGACION",
        null
      ]
    },
    "cost_budget_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^cb_[a-z0-9]+(?:_[a-z0-9]+)*_v[0-9]{3}$"
    },
    "cost_budget_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cost-budget-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "answer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retrieval_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cost_report_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "estimated_cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "enum": [
        "BOB",
        "USD",
        "NONE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "estimated_cost": [
      "currency"
    ],
    "currency": [
      "estimated_cost"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "user"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^(actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "support"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^(support_hash_[A-Za-z0-9_-]+|actor_hash_[A-Za-z0-9_-]+|sha256:[A-Fa-f0-9]{64})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "service"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "pattern": "^service_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "const": "system"
          }
        },
        "required": [
          "actor_type"
        ]
      },
      "then": {
        "properties": {
          "actor_ref": {
            "const": "system"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_scope": {
            "const": "execution"
          }
        },
        "required": [
          "event_scope"
        ]
      },
      "then": {
        "required": [
          "complexity",
          "cost_budget_ref",
          "cost_budget_version"
        ],
        "anyOf": [
          {
            "required": [
              "conversation_id"
            ],
            "properties": {
              "conversation_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "trace_id"
            ],
            "properties": {
              "trace_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "answer_id"
            ],
            "properties": {
              "answer_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "retrieval_run_id"
            ],
            "properties": {
              "retrieval_run_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "cost_report_id"
            ],
            "properties": {
              "cost_report_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "model_call_id"
            ],
            "properties": {
              "model_call_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "tool_call_id"
            ],
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ],
        "properties": {
          "complexity": {
            "enum": [
              "SIMPLE",
              "MEDIO",
              "COMPLEJO",
              "INVESTIGACION"
            ]
          },
          "cost_budget_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^cb_[a-z0-9]+(?:_[a-z0-9]+)*_v[0-9]{3}$"
