{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusnova.local/contracts/usage-event.schema.json",
  "title": "UsageEvent",
  "description": "Evento cerrado del Usage Ledger para auditar consumo tecnico, creditos y cuota de plan sin guardar PII directa ni metadata libre.",
  "type": "object",
  "x-governance": {
    "document_status": "Accepted",
    "date": "2026-05-24",
    "responsible": "Codex / JusNova Chief Backend Architect",
    "related_decision": "Subfase 0.8 - Cost Governor, planes y presupuestos"
  },
  "required": [
    "usage_event_id",
    "organization_id",
    "actor_ref",
    "actor_type",
    "plan_code",
    "billing_period",
    "event_scope",
    "event_type",
    "unit",
    "quantity",
    "created_at"
  ],
  "properties": {
    "usage_event_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+"
          }
        },
        {
          "not": {
            "pattern": "^\\+?[0-9][0-9\\s-]{5,}$"
          }
        }
      ]
    },
    "actor_type": {
      "enum": [
        "user",
        "system",
        "support",
        "service"
      ]
    },
    "plan_code": {
      "enum": [
        "PROFESIONAL",
        "PRO_PLUS",
        "ESTUDIO",
        "ENTERPRISE"
      ]
    },
    "billing_period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "event_scope": {
      "enum": [
        "execution",
        "organization_period"
      ]
    },
    "event_type": {
      "enum": [
        "standard_query",
        "complex_query",
        "research_credit_used",
        "discovery_call",
        "fetch",
        "ocr_page",
        "document_processed",
        "model_input_tokens",
        "model_output_tokens",
        "storage_mb_day"
      ]
    },
    "unit": {
      "enum": [
        "query",
        "credit",
        "call",
        "fetch",
        "page",
        "document",
        "token",
        "mb_day"
      ]
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "complexity": {
      "enum": [
        "SIMPLE",
        "MEDIO",
        "COMPLEJO",
        "INVESTIGACION",
        null
      ]
    },
    "cost_budget_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cost_budget_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cost-budget-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "answer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retrieval_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cost_report_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "estimated_cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "enum": [
        "BOB",
        "USD",
        "NONE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "estimated_cost": [
      "currency"
    ],
    "currency": [
      "estimated_cost"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_scope": {
            "const": "execution"
          }
        },
        "required": [
          "event_scope"
        ]
      },
      "then": {
        "required": [
          "complexity",
          "cost_budget_ref",
          "cost_budget_version"
        ],
        "anyOf": [
          {
            "required": [
              "conversation_id"
            ],
            "properties": {
              "conversation_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "trace_id"
            ],
            "properties": {
              "trace_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "answer_id"
            ],
            "properties": {
              "answer_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "retrieval_run_id"
            ],
            "properties": {
              "retrieval_run_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "cost_report_id"
            ],
            "properties": {
              "cost_report_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "model_call_id"
            ],
            "properties": {
              "model_call_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "tool_call_id"
            ],
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ],
        "properties": {
          "complexity": {
            "enum": [
              "SIMPLE",
              "MEDIO",
              "COMPLEJO",
              "INVESTIGACION"
            ]
          },
          "cost_budget_ref": {
            "type": "string",
            "minLength": 1
          },
          "cost_budget_version": {
            "type": "string",
            "pattern": "^cost-budget-v[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_scope": {
            "const": "organization_period"
          }
        },
        "required": [
          "event_scope"
        ]
      },
      "then": {
        "properties": {
          "complexity": {
            "const": null
          },
          "cost_budget_ref": {
            "const": null
          },
          "cost_budget_version": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "standard_query",
              "complex_query",
              "research_credit_used",
              "discovery_call",
              "fetch",
              "ocr_page",
              "model_input_tokens",
              "model_output_tokens"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_scope": {
            "const": "execution"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "storage_mb_day"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_scope": {
            "const": "organization_period"
          },
          "unit": {
            "const": "mb_day"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "standard_query"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "query"
          },
          "complexity": {
            "enum": [
              "SIMPLE",
              "MEDIO"
            ]
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "complex_query"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "query"
          },
          "complexity": {
            "enum": [
              "COMPLEJO",
              "INVESTIGACION"
            ]
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "research_credit_used"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "credit"
          },
          "complexity": {
            "enum": [
              "COMPLEJO",
              "INVESTIGACION"
            ]
          },
          "quantity": {
            "type": "integer"
          }
        },
        "anyOf": [
          {
            "required": [
              "trace_id"
            ],
            "properties": {
              "trace_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "answer_id"
            ],
            "properties": {
              "answer_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "research_credit_used"
          },
          "complexity": {
            "const": "COMPLEJO"
          }
        },
        "required": [
          "event_type",
          "complexity"
        ]
      },
      "then": {
        "properties": {
          "quantity": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "research_credit_used"
          },
          "complexity": {
            "const": "INVESTIGACION"
          }
        },
        "required": [
          "event_type",
          "complexity"
        ]
      },
      "then": {
        "properties": {
          "quantity": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "discovery_call"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "call"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "fetch"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "fetch"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ocr_page"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "page"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "document_processed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "document"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "model_input_tokens",
              "model_output_tokens"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "token"
          },
          "quantity": {
            "type": "integer"
          },
          "model_call_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "model_call_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unit": {
            "enum": [
              "query",
              "credit",
              "call",
              "fetch",
              "page",
              "document",
              "token"
            ]
          }
        },
        "required": [
          "unit"
        ]
      },
      "then": {
        "properties": {
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "currency": {
            "const": "NONE"
          }
        },
        "required": [
          "currency"
        ]
      },
      "then": {
        "properties": {
          "estimated_cost": {
            "const": 0
          }
        }
      }
    }
  ],
