          "cost_budget_version": {
            "type": "string",
            "pattern": "^cost-budget-v[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_scope": {
            "const": "organization_period"
          }
        },
        "required": [
          "event_scope"
        ]
      },
      "then": {
        "properties": {
          "complexity": {
            "const": null
          },
          "cost_budget_ref": {
            "const": null
          },
          "cost_budget_version": {
            "const": null
          },
          "conversation_id": {
            "const": null
          },
          "trace_id": {
            "const": null
          },
          "answer_id": {
            "const": null
          },
          "retrieval_run_id": {
            "const": null
          },
          "cost_report_id": {
            "const": null
          },
          "model_call_id": {
            "const": null
          },
          "tool_call_id": {
            "const": null
          }
        }
      }
    },
    {
